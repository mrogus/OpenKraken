post_install() {
    # `udevadm trigger` re-synthesizes "add" events for devices already
    # plugged in, which re-runs our rules (uaccess ACL + the hwmon chmod)
    # against them immediately -- no physical unplug/replug or reboot needed.
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
    echo ':: udev rules reloaded and applied to the already-connected Kraken.'
    echo ':: Optional: for the Web Integration LCD mode, install python-playwright'
    echo '   then run once: python -m playwright install chromium'
}

post_upgrade() {
    post_install
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
}
